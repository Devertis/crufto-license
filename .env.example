# Crufto license service configuration.
# Set these as environment variables / secrets in Coolify. Do NOT commit real values.

# Ed25519 private signing key (PKCS8 PEM). Newlines may be escaped as \n.
# The matching public key is embedded in the Crufto Cleaner app.
LICENSE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe webhook signing secret (whsec_...), from the webhook endpoint in the
# Stripe dashboard. Used only to verify webhook signatures — no API calls made.
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP for delivering the license email. Without these, licenses are still
# minted, stored and shown on the thank-you page, just not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Crufto <no-reply@crufto.com>
MAIL_REPLY_TO=

# CORS origin allowed to read the license-lookup endpoint.
ALLOW_ORIGIN=https://crufto.com

# Where the license store file lives (mount a persistent volume here).
DATA_DIR=/data

# Product identity encoded into the license.
PRODUCT=cleaner
PRODUCT_LABEL=Crufto Cleaner

PORT=8080
